{
  "name": "loupe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-devtools-style UI for inspecting Claude Code sessions from ~/.claude (read-only).",
  "license": "MIT",
  "author": "Weston Dransfield",
  "repository": { "type": "git", "url": "git+https://github.com/westonkd/loupe.git" },
  "homepage": "https://github.com/westonkd/loupe#readme",
  "bugs": { "url": "https://github.com/westonkd/loupe/issues" },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server/server/main.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@westonkd/sprint": "^0.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
